MONITOR_HOST=127.0.0.1
MONITOR_PORT=8765
MONITOR_SCAN_INTERVAL=300
MONITOR_HTTP_TIMEOUT=15
MONITOR_ITEMS_PER_SOURCE=60
MONITOR_DATA_DIR=./data
MONITOR_DB_PATH=./data/monitor.db
MONITOR_CREDENTIAL_PATH=./data/credentials.json

# Optional AI analysis layer (OpenAI-compatible Chat Completions)
MONITOR_AI_BASE_URL=
MONITOR_AI_API_KEY=
MONITOR_AI_MODEL=
MONITOR_AI_WIRE_API=chat_completions
MONITOR_AI_TIMEOUT=45
MONITOR_AI_MAX_ITEMS=20

# Alert delivery (optional)
MONITOR_ALERT_WEBHOOK_URL=
MONITOR_ALERT_WEBHOOK_TYPE=generic
MONITOR_ALERT_MIN_RISK=medium
MONITOR_ALERT_TIMEOUT=10
MONITOR_SMTP_HOST=
MONITOR_SMTP_PORT=465
MONITOR_SMTP_USER=
MONITOR_SMTP_PASSWORD=
MONITOR_SMTP_FROM=
MONITOR_ALERT_EMAIL_TO=
MONITOR_SMTP_SSL=true

# Docker port bind address
MONITOR_BIND_ADDRESS=127.0.0.1
